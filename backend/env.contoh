# Salin file ini menjadi .env (di folder backend), lalu isi nilainya:
#   copy env.contoh .env
# File .env tidak ikut diunggah ke GitHub.

# Kode rahasia untuk mendaftar akun guru dari halaman awal game.
# Bagikan hanya ke guru. Kosongkan jika pendaftaran guru mau ditutup.
KODE_DAFTAR_GURU=ganti-dengan-kode-rahasia

# Alamat PostgreSQL (misalnya dari Neon). Kosongkan untuk memakai SQLite
# (file backend/jejak_kode.db), cocok untuk server di laptop guru.
DATABASE_URL=
